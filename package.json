{
  "name": "sshdeck",
  "version": "0.1.4",
  "description": "Fast, tag-based SSH connection manager for Windows, macOS and Linux.",
  "author": "SSHDeck Contributors",
  "license": "MIT",
  "keywords": [
    "ssh",
    "ssh-client",
    "ssh-manager",
    "cli",
    "terminal",
    "devops"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mehmetduran932/sshdeck.git"
  },
  "bugs": {
    "url": "https://github.com/mehmetduran932/sshdeck/issues"
  },
  "homepage": "https://github.com/mehmetduran932/sshdeck#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "sshdeck": "dist/cli.js",
    "sd": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.10.1",
    "commander": "^12.1.0",
    "keytar": "^7.9.0",
    "picocolors": "^1.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^20.17.0",
    "eslint": "^9.14.0",
    "prettier": "^3.3.3",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vitest": "^2.1.4"
  }
}
